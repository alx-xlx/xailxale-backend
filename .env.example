# Copy this file to .env and edit the values you need.
#
# Modes:
# - self: the container starts its own tailscaled
# - host: the container reuses the host machine's tailscaled socket
TS_CONNECTION_MODE=self

# Self mode only.
# Required if you want the container to sign in to Tailscale automatically.
# Not needed in host mode.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx
TS_HOSTNAME=tailscale-monitor
TS_ACCEPT_DNS=false
TS_ACCEPT_ROUTES=false
TS_ADVERTISE_TAGS=
TS_EXTRA_ARGS=
TS_USERSPACE=false

# Polling / API settings.
TS_POLL_INTERVAL_SECONDS=60
TS_TAILSCALE_TIMEOUT_SECONDS=15
APP_PORT=5189

# Host mode socket path inside the container.
# You usually do not need to change this.
TS_HOST_SOCKET=/host-tailscale/tailscaled.sock

# Leave empty unless you need to force a custom socket path for the app.
TAILSCALE_SOCKET=
